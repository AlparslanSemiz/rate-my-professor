# Path the panel calls in development. `/api` keeps development same-origin: the dev server
# proxies it to VITE_API_TARGET and strips the prefix before forwarding (see vite.config.ts).
#
# Production uses neither this value nor `/api`. The deployed panel and the backend share one
# host, so CI builds with an EMPTY VITE_API_BASE_URL and every call goes out same-origin. `/api`
# cannot survive into production because nothing strips it there -- .gitlab-ci.yml carries the
# measurement.
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards to. Point it at a local backend when you run one.
VITE_API_TARGET=https://server.example.org

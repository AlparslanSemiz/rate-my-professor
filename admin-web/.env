# Path the panel calls. `/api` keeps development same-origin: the dev server proxies it to
# VITE_API_TARGET (see vite.config.ts). Production builds override this with the absolute
# backend URL through the VITE_API_BASE_URL build argument.
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards to. Point it at a local backend when you run one.
VITE_API_TARGET=https://server.example.org

# Rendered at container start: the nginx image runs envsubst over /etc/nginx/templates and
# substitutes ADMIN_BASE_PATH, which is set from the VITE_BASE_PATH build argument so the
# served path always matches the path baked into the bundle. nginx variables such as $uri are
# left alone because envsubst only replaces names that exist in the environment.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Asset file names contain a content hash, so they can be cached indefinitely.
    location ${ADMIN_BASE_PATH}assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # index.html must never be cached, otherwise a browser keeps loading the previous
    # release's asset names after a deploy. Unknown paths fall back to it so that a direct
    # link or a refresh on a client-side route still works.
    location ${ADMIN_BASE_PATH} {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ ${ADMIN_BASE_PATH}index.html;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}

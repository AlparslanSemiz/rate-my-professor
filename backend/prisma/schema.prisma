generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  DELETED

  @@map("content_status")
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN

  @@map("report_status")
}

/// Current Spring Boot login table used by TokenService.
model MagicLoginToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("magic_login_tokens")
}

model Professor {
  id        String  @id @default(uuid()) @db.Uuid
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  photoUrl  String? @map("photo_url")
  isActive  Boolean @default(true) @map("is_active")

  /// Cached value from all Rating rows. Update it together with ratingCount.
  averageRating Decimal @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingCount   Int     @default(0) @map("rating_count")

  lectures Lecture[]
  ratings  Rating[]
  comments Comment[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([isActive])
  @@map("professors")
}

/// One row represents one lecture offering taught by exactly one professor.
/// The same lecture name/code may occur for different professors or semesters.
model Lecture {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  code     String?
  semester String?
  isActive Boolean @default(true) @map("is_active")

  professorId String    @map("professor_id") @db.Uuid
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@index([professorId, isActive])
  @@map("lectures")
}

model Student {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique
  kitEmail        String    @unique @map("kit_email")
  photoUrl        String?   @map("photo_url")
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Optional feature from the user stories.
  credibilityScore Int @default(0) @map("credibility_score")

  ratings        Rating[]
  comments       Comment[]
  answers        Answer[]
  commentReports CommentReport[]
  answerReports  AnswerReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("students")
}

/// A student can rate a professor only once.
model Rating {
  id String @id @default(uuid()) @db.Uuid

  /// Must be between 0 and 5. Enforce this in application validation
  /// and preferably with a PostgreSQL CHECK constraint in the migration.
  value Int @db.SmallInt

  studentId   String @map("student_id") @db.Uuid
  professorId String @map("professor_id") @db.Uuid

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, professorId])
  @@index([professorId])
  @@map("ratings")
}

/// A student may create any number of comments for the same professor.
model Comment {
  id      String        @id @default(uuid()) @db.Uuid
  content String        @db.Text
  status  ContentStatus @default(VISIBLE)

  studentId   String @map("student_id") @db.Uuid
  professorId String @map("professor_id") @db.Uuid

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  answers Answer[]
  reports CommentReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([professorId, createdAt])
  @@index([studentId])
  @@map("comments")
}

/// Every answer belongs to exactly one comment.
/// A comment may have zero, one, or many answers.
model Answer {
  id      String        @id @default(uuid()) @db.Uuid
  content String        @db.Text
  status  ContentStatus @default(VISIBLE)

  studentId String @map("student_id") @db.Uuid
  commentId String @map("comment_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reports AnswerReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([commentId, createdAt])
  @@index([studentId])
  @@map("answers")
}

/// A student may report the same comment only once.
model CommentReport {
  id     String       @id @default(uuid()) @db.Uuid
  reason String       @db.Text
  status ReportStatus @default(OPEN)

  reporterId String @map("reporter_id") @db.Uuid
  commentId  String @map("comment_id") @db.Uuid

  reporter Student @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
  @@map("comment_reports")
}

/// A student may report the same answer only once.
model AnswerReport {
  id     String       @id @default(uuid()) @db.Uuid
  reason String       @db.Text
  status ReportStatus @default(OPEN)

  reporterId String @map("reporter_id") @db.Uuid
  answerId   String @map("answer_id") @db.Uuid

  reporter Student @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  answer   Answer  @relation(fields: [answerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reporterId, answerId])
  @@index([status, createdAt])
  @@index([answerId])
  @@map("answer_reports")
}

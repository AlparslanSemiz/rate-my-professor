{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Path alias. Mirrors `resolve.alias` in vite.config.ts; change the two together.
       No `baseUrl`: it is deprecated in TypeScript 6, and `paths` resolves relative to this
       file without it. */
    "paths": { "@/*": ["./src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. `strict` is on and was already satisfied — turning it on produced zero
       errors across src/. It is declared so that it stays that way: without the flag,
       the next `any` or unchecked null slips in silently, and README.md and wiki.md
       have been claiming strict checks that nothing enforced. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

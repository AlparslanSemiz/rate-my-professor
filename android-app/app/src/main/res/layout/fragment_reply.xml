<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".fragments.ReplyFragment">

    <com.example.liquidglass.LiquidGlassFab
        android:id="@+id/back_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/back"
        android:elevation="8dp"
        android:src="@drawable/go_back_icon"
        app:adaptiveTint="true"
        app:bevelWidth="8dp"
        app:cornerRadius="32dp"
        app:dispersionStrength="0.08"
        app:glassMaterial="regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:refractionHeight="28dp" />

    <include
        android:id="@+id/main_comment"
        layout="@layout/item_comment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Replies"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reply_input" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reply_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_box"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_comment">

        <EditText
            android:id="@+id/input_reply"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/rounded_box_dark"
            android:fontFamily="@font/inter_bold"
            android:gravity="top|start"
            android:hint="write a reply..."
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="0"
            android:text="Submit Reply"
            android:textAllCaps="false"
            android:textColor="#282828"
            android:textSize="16sp"
            android:typeface="normal"
            app:backgroundTint="#CFCFCF"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_reply" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="0"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#282828"
            android:textSize="16sp"
            android:typeface="normal"
            app:backgroundTint="#CFCFCF"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="@id/submit_reply"
            app:layout_constraintEnd_toStartOf="@id/submit_reply"
            app:layout_constraintTop_toTopOf="@id/submit_reply" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/answer_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

</androidx.constraintlayout.widget.ConstraintLayout>

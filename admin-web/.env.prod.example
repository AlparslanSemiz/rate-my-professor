# Copy to .env.prod on the deployment host. Both values are baked into the static bundle at
# build time, so changing either one requires rebuilding the image.

# Backend the panel calls. The panel is served from the same host, so this is same-origin.
VITE_API_BASE_URL=https://server.example.org

# Public URL path the panel is served from. Must match the Nginx location on the host.
VITE_BASE_PATH=/admin/

# Loopback port the container publishes for the host's Nginx to proxy to.
WEB_PORT=8081

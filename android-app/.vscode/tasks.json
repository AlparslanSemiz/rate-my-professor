{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$env:JAVA_HOME='C:\\Program Files\\Android\\Android Studio\\jbr'; $env:Path=\"$env:JAVA_HOME\\bin;$env:Path\"; .\\gradlew.bat assembleDebug"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: Install Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$env:JAVA_HOME='C:\\Program Files\\Android\\Android Studio\\jbr'; $env:Path=\"$env:JAVA_HOME\\bin;$env:Path\"; .\\gradlew.bat installDebug"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: Launch App",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& \"$env:LOCALAPPDATA\\Android\\Sdk\\platform-tools\\adb.exe\" shell monkey -p com.example.ratemyprofessor -c android.intent.category.LAUNCHER 1"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Android: Install & Launch",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Android: Install Debug",
                "Android: Launch App"
            ],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "panel": "dedicated"

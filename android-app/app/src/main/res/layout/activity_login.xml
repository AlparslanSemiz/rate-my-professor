<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".activities.LoginActivity" >

    <TextView
        android:id="@+id/input_background"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/rounded_box"
        android:fontFamily="@font/inter_bold"
        android:text="Verify your KIT E-Mail"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499" />

    <EditText
        android:id="@+id/mail_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rounded_box_very_light"
        android:ems="10"
        android:fontFamily="@font/inter_bold"
        android:hint="mail adress..."
        android:inputType="text"
        android:lineSpacingExtra="8sp"
        android:paddingStart="8dp"
        android:textAlignment="textStart"
        android:textColor="@color/text_on_input_field"
        android:textSize="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_background"
        app:layout_constraintEnd_toEndOf="@+id/input_background"
        app:layout_constraintStart_toStartOf="@+id/input_background" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/verify_button"
        style="@style/text_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/input_field_background"
        android:letterSpacing="0"
        android:text="Verify"
        android:textSize="24sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="@+id/input_background"
        app:layout_constraintTop_toBottomOf="@+id/input_background" />
</androidx.constraintlayout.widget.ConstraintLayout>
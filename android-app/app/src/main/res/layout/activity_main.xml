<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/custom_bottom_nav"
        android:layout_width="350dp"
        android:layout_height="80dp"
        android:layout_marginBottom="30dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cornerRadius="40dp"
        app:glassMaterial="regular"
        app:refractionHeight="40dp"
        app:bevelWidth="12dp"
        app:dispersionStrength="0.10"
        app:adaptiveTint="true">

        <View
            android:id="@+id/nav_indicator"
            android:layout_width="90dp"
            android:layout_height="60dp"

            android:layout_gravity="center"
            android:background="@drawable/bottom_nav_bubble"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/nav_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bottom_nav_selected_bubble"
                android:src="@drawable/search_icon"
                android:scaleType="center"
                app:tint="@color/bottom_nav_icon" />

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bottom_nav_selected_bubble"
                android:src="@drawable/home_icon"
                android:scaleType="center"
                app:tint="@color/bottom_nav_icon" />

            <ImageButton
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bottom_nav_selected_bubble"
                android:src="@drawable/settings_icon"
                android:scaleType="center"
                app:tint="@color/bottom_nav_icon" />

        </LinearLayout>
    </com.example.liquidglass.LiquidGlassView>


</androidx.constraintlayout.widget.ConstraintLayout>

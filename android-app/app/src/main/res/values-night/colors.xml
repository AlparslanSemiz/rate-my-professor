<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark counterpart of values/colors.xml. Every name declared there is overridden here,
        so a name that is missing in this file would silently fall back to its light value.
    -->

    <!-- Backgrounds, from the screen background up to the most raised element on it. -->
    <color name="surface">#FF000000</color>
    <color name="surface_container">#FF282828</color>
    <color name="surface_container_high">#FF575757</color>
    <color name="surface_container_low">#FF1C1C1C</color>

    <!-- Background of elements that deliberately invert the screen, like the submit button. -->
    <color name="surface_inverse">#FFE9E9E9</color>

    <!-- Text. -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_muted">#FF9D9D9D</color>
    <color name="text_hint">#FF575757</color>
    <color name="text_on_inverse">#FF000000</color>

    <!-- Input fields keep a filled look that contrasts with the screen background. -->
    <color name="input_field_background">#FFCFCFCF</color>
    <color name="text_on_input_field">#FF282828</color>

    <color name="icon_tint">#FFFFFFFF</color>
    <color name="outline">#FF575757</color>

    <!-- Accents. Destructive actions, positive ratings and the rating bars. -->
    <color name="danger">#FFCF2A0E</color>
    <color name="accent_positive">#FF4CAF50</color>
    <color name="rating_good">#FF228B22</color>
    <color name="rating_bar">#FFE6B400</color>

    <!-- Floating chrome. The alpha keeps the content underneath slightly visible. -->
    <color name="bottom_nav_background">#CC282828</color>
    <color name="bottom_nav_icon">#FFFFFFFF</color>
    <color name="circle_button_background">#33D9D9D9</color>
    <color name="search_button_background">#66575757</color>
    <color name="glass_background">#80282828</color>

    <!-- Dark mode switch. -->
    <color name="switch_thumb_on">#FFE9E9E9</color>
    <color name="switch_thumb_off">#FF9D9D9D</color>
    <color name="switch_track_on">#FF30D158</color>
    <color name="switch_track_off">#FF575757</color>

    <!-- Search screen tabs. -->
    <color name="selected_tab_color">#FF575757</color>
    <color name="unselected_tab_color">#FF282828</color>
    <color name="selected_tab_text_color">#FFFFFFFF</color>
    <color name="unselected_tab_text_color">#FFFFFFFF</color>

</resources>

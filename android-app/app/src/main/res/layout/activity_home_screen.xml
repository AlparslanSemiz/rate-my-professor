<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">


    <TextView
        android:id="@+id/profile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/rounded_box"
        android:textAlignment="textEnd"
        android:textColor="#FDFDFD"
        app:layout_constraintBottom_toBottomOf="@id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imageView" />

    <TextView
        android:id="@+id/your_stats_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/rounded_box"
        android:fontFamily="@font/inter_bold"
        android:textColor="#FDFDFD"
        android:textSize="200sp"
        app:layout_constraintBottom_toBottomOf="@+id/up_downvotes_num"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile" />

    <TextView
        android:id="@+id/your_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Your Stats"
        android:textColor="#FBFBFB"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/average_rating_given"
        app:layout_constraintStart_toStartOf="@+id/your_stats_background"
        app:layout_constraintTop_toTopOf="@+id/your_stats_background" />

    <TextView
        android:id="@+id/average_rating_given"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Average Rating Given"
        android:textColor="#FBFBFB"
        app:layout_constraintStart_toStartOf="@+id/your_stats_background"
        app:layout_constraintTop_toBottomOf="@+id/your_stats" />

    <TextView
        android:id="@+id/average_rating_given_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="3,0"
        android:textColor="#FBFBFB"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/average_rating_given"
        app:layout_constraintTop_toBottomOf="@+id/average_rating_given" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/list_of_my_ratings_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#282828"
        android:clickable="true"
        android:focusable="true"
        style="@style/text_style"
        android:letterSpacing="0"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="List of my ratings"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        android:textColor="#FDFDFD"
        android:textSize="24sp"
        android:typeface="normal"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/your_stats_background" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/notifications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="200dp"
        android:backgroundTint="#282828"
        app:cornerRadius="24dp"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        android:textColor="#FDFDFD"
        android:textSize="24sp"
        android:textStyle="bold"
        android:typeface="normal"
        android:clickable="true"
        android:focusable="true"
        style="@style/text_style"
        android:letterSpacing="0"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Notifications"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list_of_my_ratings_button"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/professors_rated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Professors Rated"
        android:textColor="#FBFBFB"
        app:layout_constraintStart_toStartOf="@+id/your_stats_background"
        app:layout_constraintTop_toBottomOf="@+id/average_rating_given_num" />

    <TextView
        android:id="@+id/average_rating_given_num2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="5"
        android:textColor="#FBFBFB"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/average_rating_given"
        app:layout_constraintTop_toBottomOf="@+id/professors_rated" />

    <TextView
        android:id="@+id/comments_written"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Comments Written"
        android:textColor="#FBFBFB"
        app:layout_constraintStart_toStartOf="@+id/your_stats_background"
        app:layout_constraintTop_toBottomOf="@+id/average_rating_given_num2" />

    <TextView
        android:id="@+id/comments_written_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="39"
        android:textColor="#FBFBFB"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/average_rating_given"
        app:layout_constraintTop_toBottomOf="@+id/comments_written" />

    <TextView
        android:id="@+id/up_downvotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Up-/Downvotes"
        android:textColor="#FBFBFB"
        app:layout_constraintStart_toStartOf="@+id/your_stats_background"
        app:layout_constraintTop_toBottomOf="@+id/comments_written_num" />

    <TextView
        android:id="@+id/up_downvotes_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="-7"
        android:textColor="#FBFBFB"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/average_rating_given"
        app:layout_constraintTop_toBottomOf="@+id/up_downvotes" />

    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Username"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        app:layout_constraintBottom_toBottomOf="@+id/profile"
        app:layout_constraintEnd_toEndOf="@+id/profile"
        app:layout_constraintStart_toEndOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/profile" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="159dp"
        android:layout_height="189dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/your_stats_background"
        app:layout_constraintStart_toStartOf="@+id/profile"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.348"
        tools:srcCompat="@tools:sample/avatars" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/rounded_box"
        app:menu="@menu/bottom_navigation_bar"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
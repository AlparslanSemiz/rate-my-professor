<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_dialog_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Bug Report"
            android:textColor="#E9E9E9"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/bug_report_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/settings_circle_button"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/close_icon"
            android:tint="#E9E9E9" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:text="What went wrong?"
        android:textColor="#9D9D9D"
        android:textSize="15sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/bug_report_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Describe the bug"
        app:boxBackgroundColor="#1C1C1C"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusTopStart="20dp"
        app:boxStrokeColor="#575757"
        app:errorTextColor="#921800"
        app:hintTextColor="#9D9D9D">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/bug_report_input"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:fontFamily="@font/inter"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="8"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:textColor="#E9E9E9"
            android:textColorHint="#9D9D9D"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bug_report_cancel"
            style="@style/text_style"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="#1C1C1C"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="Cancel"
            android:textColor="#E9E9E9"
            android:textSize="16sp"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bug_report_submit"
            style="@style/text_style"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="#E9E9E9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="Submit"
            android:textColor="#000000"
            android:textSize="16sp"
            app:cornerRadius="26dp" />
    </LinearLayout>

</LinearLayout>

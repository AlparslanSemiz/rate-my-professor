<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.example.liquidglass.LiquidGlassButton
        android:id="@+id/profsButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="4dp"
        android:elevation="8dp"
        android:text="Professors"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:glassMaterial="regular"
        app:refractionHeight="28dp"
        app:bevelWidth="8dp"
        app:dispersionStrength="0.08"
        app:adaptiveTint="true"
        app:layout_constraintEnd_toStartOf="@id/lecturesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.liquidglass.LiquidGlassButton
        android:id="@+id/lecturesButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:elevation="8dp"
        android:text="Lectures"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:glassMaterial="regular"
        app:refractionHeight="28dp"
        app:bevelWidth="8dp"
        app:dispersionStrength="0.08"
        app:adaptiveTint="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/profsButton"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/searchViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.liquidglass.LiquidGlassFab
        android:id="@+id/search_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="128dp"
        android:src="@drawable/search_icon"
        app:cornerRadius="36dp"
        app:glassMaterial="regular"
        app:refractionHeight="32dp"
        app:bevelWidth="10dp"
        app:dispersionStrength="0.10"
        app:adaptiveTint="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/surface"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Search"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:backgroundTint="@color/surface_container_high" />

        <ImageButton
            android:id="@+id/clearSearchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/icon_tint" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
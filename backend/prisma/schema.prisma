generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  DELETED

  @@map("content_status")
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTION_TAKEN

  @@map("report_status")
}

enum SemesterSeason {
  SUMMER
  WINTER

  @@map("semester_season")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED

  @@map("user_status")
}

/// An ANSWER notification carries an answer and no message; a WARNING
/// notification carries a message and no answer.
enum NotificationType {
  ANSWER
  WARNING

  @@map("notification_type")
}

model OneTimePassword {
  id          Int      @id @default(autoincrement())
  email       String
  hash        String?  @db.Text
  legacyValue String?  @map("value") @db.Text
  used        Boolean  @default(false)
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([email])
  @@index([email, used, expiresAt])
  @@map("one_time_passwords")
}

model Token {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  hash        String?  @db.Text
  legacyValue String?  @map("value") @db.Text
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)
  revoked     Boolean  @default(false)
  studentId   String?  @map("student_id") @db.Uuid
  student     Student? @relation(fields: [studentId], references: [id])

  @@index([email])
  @@index([hash])
  @@index([expiresAt])
  @@index([revoked])
  @@map("tokens")
}

model Professor {
  id        String  @id @default(uuid()) @db.Uuid
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  isActive  Boolean @default(true) @map("is_active")

  /// Cached value from all Rating rows. Update it together with ratingCount.
  averageRating Decimal @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingCount   Int     @default(0) @map("rating_count")

  modules Module[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([isActive])
  @@map("professors")
}

/// One row represents one module offering taught by exactly one professor.
/// The same module name/code may occur for different professors or semesters.
model Module {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  code           String?
  semesterYear   Int            @map("semester_year")
  semesterSeason SemesterSeason @map("semester_season")
  isActive       Boolean        @default(true) @map("is_active")

  professorId String    @map("professor_id") @db.Uuid
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  comments Comment[]
  ratings  Rating[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@index([semesterYear, semesterSeason])
  @@index([professorId, isActive])
  @@map("lectures")
}

model Student {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique
  kitEmail        String    @unique @map("kit_email")
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// Optional feature from the user stories.
  credibilityScore Int @default(0) @map("credibility_score")

  status    UserStatus @default(ACTIVE)
  biography String?    @db.Text

  lastSeenAt    DateTime? @map("last_seen_at")
  blockedAt     DateTime? @map("blocked_at")
  blockedReason String?   @map("blocked_reason")

  /// Set when the account is deleted. Deletion anonymizes the row rather than
  /// removing it, so that authored content keeps a valid foreign key.
  deletedAt DateTime? @map("deleted_at")

  ratings        Rating[]
  comments       Comment[]
  answers        Answer[]
  commentReports CommentReport[]
  answerReports  AnswerReport[]
  tokens         Token[]
  notifications  Notification[]
  warnings       Warning[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("students")
}

/// A student can rate a module only once.
model Rating {
  id String @id @default(uuid()) @db.Uuid

  studentId String @map("student_id") @db.Uuid
  moduleId  String @map("lecture_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topics  RatingTopic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("ratings")
}

model RatingTopic {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  value Int    @db.SmallInt

  ratingId String @map("rating_id") @db.Uuid
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@unique([ratingId, name])
  @@map("rating_topics")
}

/// A student may create any number of comments for the same module.
model Comment {
  id      String        @id @default(uuid()) @db.Uuid
  content String        @db.Text
  status  ContentStatus @default(VISIBLE)

  studentId String @map("student_id") @db.Uuid
  moduleId  String @map("lecture_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  answers Answer[]
  reports CommentReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([moduleId, createdAt])
  @@index([studentId])
  @@index([moduleId, status])
  @@map("comments")
}

/// Every answer belongs to exactly one comment.
/// A comment may have zero, one, or many answers.
model Answer {
  id      String        @id @default(uuid()) @db.Uuid
  content String        @db.Text
  status  ContentStatus @default(VISIBLE)

  studentId String @map("student_id") @db.Uuid
  commentId String @map("comment_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reports       AnswerReport[]
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([commentId, createdAt])
  @@index([studentId])
  @@map("answers")
}

/// Delivered to a student in their own feed. Either a reply to something they
/// wrote (ANSWER) or a disciplinary warning issued by an administrator
/// (WARNING). A warning notification is informational only — it never restricts
/// the account, which is what distinguishes it from a block.
model Notification {
  id   String           @id @default(uuid()) @db.Uuid
  type NotificationType @default(ANSWER)

  recipientId String  @map("recipient_id") @db.Uuid
  recipient   Student @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  /// Null for WARNING rows.
  answerId String? @map("answer_id") @db.Uuid
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  /// Only populated for WARNING rows.
  message String? @db.Text

  seen Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipientId, seen, createdAt(sort: Desc)])
  @@map("notifications")
}

/// A disciplinary record against a student, issued by an administrator. Warnings
/// accumulate and are never reversed; they do not restrict access. Revoking
/// access is a separate action recorded on Student.status.
model Warning {
  id      String @id @default(uuid()) @db.Uuid
  message String @db.Text

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The issuing administrator. Not modelled as a relation here because the
  /// admins table is still Hibernate-owned.
  adminId String @map("admin_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("warnings")
}

/// A student may report the same comment only once.
model CommentReport {
  id     String       @id @default(uuid()) @db.Uuid
  reason String       @db.Text
  status ReportStatus @default(OPEN)

  reporterId String @map("reporter_id") @db.Uuid
  commentId  String @map("comment_id") @db.Uuid

  reporter Student @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
  @@map("comment_reports")
}

/// A student may report the same answer only once.
model AnswerReport {
  id     String       @id @default(uuid()) @db.Uuid
  reason String       @db.Text
  status ReportStatus @default(OPEN)

  reporterId String @map("reporter_id") @db.Uuid
  answerId   String @map("answer_id") @db.Uuid

  reporter Student @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  answer   Answer  @relation(fields: [answerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reporterId, answerId])
  @@index([status, createdAt])
  @@index([answerId])
  @@map("answer_reports")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorType   String   @map("actor_type")
  actorId     String   @map("actor_id") @db.Uuid
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  actorRole   String   @map("actor_role")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  targetLabel String?  @map("target_label") @db.Text
  changes     Json     @default("{}")
  metadata    Json     @default("{}")

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@map("audit_logs")
}

model AuthRateLimitBucket {
  id              String   @id @default(uuid()) @db.Uuid
  operation       String
  subjectHash     String   @map("subject_hash")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamp(6)
  attempts        Int
  version         BigInt   @default(0)

  @@unique([operation, subjectHash])
  @@index([windowStartedAt])
  @@map("auth_rate_limit_buckets")
}

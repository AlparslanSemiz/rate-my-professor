<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Bug Report"
        android:textColor="#E9E9E9"
        android:textSize="22sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="Describe the bug"
        app:boxBackgroundColor="#1C1C1C"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxStrokeColor="#575757"
        app:hintTextColor="#9D9D9D">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/bug_report_input"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:fontFamily="@font/inter"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="8"
            android:textColor="#E9E9E9"
            android:textColorHint="#9D9D9D"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
